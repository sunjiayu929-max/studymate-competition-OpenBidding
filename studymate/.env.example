# StudyMate 环境配置示例
# 复制到 backend/.env 后按需填入真实 Key；未配置的外部能力会使用项目兜底或返回明确提示。
# 使用：cp .env.example backend/.env

# ===== 主流程大模型 =====
# 主流程提供商：deepseek / mimo / spark。
# AI 助教与主流程解耦，使用下方 QWEN_* 配置。
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容；模型名称以账号控制台当前可用项为准）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# 讯飞星火（OpenAI 兼容模式；https://console.xfyun.cn 申请）
# APIPassword 形如 xxx:yyy，整体作为 Bearer
# 模型示例：
#   4.0Ultra      —— 通用模型
#   x1            —— 推理模型
# 4.0Ultra/generalv3.5 走 /v1，x1 走 /v2
SPARK_API_KEY=
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=4.0Ultra

# 小米 MiMo（OpenAI 兼容）
# tp-*  订阅制 → https://token-plan-cn.xiaomimimo.com/v1
# sk-*  按量付费 → https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# 通义千问（助教、视觉理解、Embedding 与 CosyVoice 共用 DashScope 账号）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
QWEN_VL_MODEL=qwen-vl-max

# ===== 语义向量 =====
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ===== 数据库 =====
# 默认 SQLite（本地运行库；Docker 使用脱敏压缩 seed，含 5 门课 938 chunks）
DATABASE_URL=sqlite:///./studymate.db

# 切到 Postgres 时（启动 --profile extras 后）：
# DATABASE_URL=postgresql+asyncpg://studymate:studymate@postgres:5432/studymate

# ===== 向量存储扩展预留 =====
# 当前主链路把 Embedding 保存在 SQLite JSON 列；该目录只供未来 Chroma 迁移使用。
CHROMA_PERSIST_DIR=./data/chroma

# ===== 讯飞语音 ASR + TTS =====
# 与星火大模型不同 SKU，需在 https://console.xfyun.cn 独立开通「语音听写」+「在线语音合成」
# 不填则语音功能（朗读 / 讲课模式 / 语音助教）返回 503，其余功能正常
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# TTS 总引擎：xfyun=讯飞（默认）；cosyvoice=阿里 CosyVoice（音色更自然，复用下面 QWEN_API_KEY）
# 嫌讯飞在线音色机械 → 设 cosyvoice（需在 DashScope 控制台开通「语音合成」服务）；前端无需改动
TTS_ENGINE=xfyun
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_VOICE=longxiaochun_v3
# 多账号 key 池，逗号分隔；留空时回退 QWEN_API_KEY
COSYVOICE_API_KEYS=

# 讯飞 TTS 子模式：online=在线语音合成（默认）；oral=超拟人语音合成（音质更高，需控制台「超拟人合成」授权）
# 切超拟人：把下面改 oral，并填好服务路由 + 已授权发音人；前端无需改动
XFYUN_TTS_MODE=online
# 超拟人服务完整 wss 地址，形如 wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/xxxxxxxx
# （xxxxxxxx 是控制台为你的超拟人服务分配的路由，按实际填）
XFYUN_ORAL_TTS_URL=
# 超拟人默认发音人（如 x4_lingxiaoxuan_oral / x4_lingfeihao_oral，按已授权的填）
XFYUN_ORAL_VOICE=x4_lingxiaoxuan_oral

# ===== 在线代码沙箱 =====
# 本地裸跑使用 127.0.0.1；Docker Compose 会覆盖为 piston-api:2000
PISTON_URL=http://127.0.0.1:2000
PISTON_TIMEOUT_MS=10000

# ===== 应用服务 =====
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== 邮箱注册 / 登录（QQ 邮箱） =====
# 在 QQ 邮箱「设置 → 账号与安全 → SMTP/IMAP」开启服务并生成授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StudyMate
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# 可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成。
AUTH_SECRET_KEY=
SESSION_EXPIRE_DAYS=7
# 线上 HTTPS 环境改为 true；本地 http 开发保持 false。
SESSION_COOKIE_SECURE=false
