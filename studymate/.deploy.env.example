# Ubuntu 生产环境启用 Caddy 公网入口和 Piston 代码运行服务。
COMPOSE_PROFILES=public,code-runner

# 只填写已备案域名，不带协议和路径。
SITE_ADDRESS=matropic.cn

# The independent interview service is proxied by this host at /interview/.
# Configure backend/.env AI_INTERVIEW_PUBLIC_URL with the matching full URL.
# Enable only after ../ai-interview/.env has been configured. The deploy script
# starts the main stack first, then starts this independent Compose project.
AI_INTERVIEW_ENABLED=0
AI_INTERVIEW_DIR=../ai-interview

# Independent Hydro OJ project, proxied by the main Caddy at /oj/.
# Enable only after ../oj/.env has been configured.
OJ_ENABLED=0
OJ_DIR=../oj
REQUIRE_DEPLOY_BRANCH=1
REQUIRE_BACKUP=1
# Production must not recreate fixed demo credentials on backend restarts.
SEED_DEMO_USERS=0
# Required when the deploy host intentionally has no .git metadata. Set this
# to the commit/digest recorded by CI for the source or image being deployed.
# DEPLOY_SOURCE_REVISION=replace-with-release-commit

# 生产环境保持 80/443，供 Caddy 完成 ACME 验证和 HTTPS 服务。
HTTP_PORT=80
HTTPS_PORT=443
# Main backend database connection. Keep the default on the persistent Docker
# volume; replace with a complete SQLAlchemy URL for PostgreSQL or another
# supported driver.
DATABASE_URL=sqlite:///./data/studymate.db

# 如果服务器无法访问 Docker Hub 或 GHCR，可改为可信镜像地址，
# 或填写已通过 `docker load` 导入的本地镜像名。
# CADDY_IMAGE=caddy:2-alpine
# PISTON_IMAGE=ghcr.io/engineer-man/piston:latest
# PYTHON_IMAGE=python:3.11-slim
# NODE_IMAGE=node:20-alpine
# NGINX_IMAGE=nginx:alpine
# Current server uses the following reachable Docker Hub proxy values:
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine
