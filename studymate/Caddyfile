# SITE_ADDRESS examples:
#   Local:      http://localhost
#   Production: studymate.example.com
# Caddy automatically provisions and renews HTTPS for a real public domain.
{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	# Low-latency mode is important for FastAPI/SSE token streaming.
	reverse_proxy frontend:80 {
		flush_interval -1
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
