page {
  background: #edf7fb;
  color: #18384d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  font-family: inherit;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f6fbfd 0%, #edf7fb 42%, #e8f4f9 100%);
}

.page-narrow {
  padding-top: 88rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid #8fc3db;
  border-radius: 18rpx;
  background: #286486;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.eyebrow {
  display: block;
  color: #4f7e98;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-top: 6rpx;
  color: #18384d;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.muted {
  color: #688596;
}

.top-space {
  margin-top: 40rpx;
}

.card {
  border: 1rpx solid #c9e1ec;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 10rpx 28rpx rgba(42, 101, 133, .07);
}

.primary-button,
.secondary-button,
.ghost-button {
  min-height: 88rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f7196;
  color: #fff;
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: .5;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b7d6e5;
  background: #f4fafd;
  color: #2f7196;
}

.ghost-button {
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid #c5deea;
  background: rgba(255, 255, 255, .72);
  color: #3d6f89;
  font-size: 24rpx;
}

.primary-button:active,
.secondary-button:active,
.ghost-button:active,
.task-card:active {
  opacity: .82;
}

.field-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #315268;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  border: 1rpx solid #c5deea;
  border-radius: 14rpx;
  background: #fff;
  color: #18384d;
  font-size: 28rpx;
}

.input:focus {
  border-color: #4a91b6;
}

.error-box,
.success-box {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.error-box {
  border: 1rpx solid #c9dfeb;
  background: #f1f8fc;
  color: #2d6b8c;
}

.success-box {
  border: 1rpx solid #bcdbe8;
  background: #f1f9fc;
  color: #2f7196;
}

.loading-box,
.empty-box {
  padding: 70rpx 28rpx;
  border: 1rpx dashed #bad8e6;
  border-radius: 18rpx;
  background: rgba(248, 252, 254, .92);
  color: #688596;
  text-align: center;
  line-height: 1.7;
}

.status-pill,
.type-pill {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.status-pill {
  background: #e7f2f7;
  color: #52768a;
}

.type-pill.training {
  background: #deedf6;
  color: #2f7196;
}

.type-pill.reading {
  background: #eef5f8;
  color: #547a8d;
}

.section-title {
  display: block;
  color: #21465e;
  font-size: 30rpx;
  font-weight: 800;
}

.section-detail {
  display: block;
  margin-top: 8rpx;
  color: #718b99;
  font-size: 22rpx;
  line-height: 1.6;
}
