page {
  background: #f3f0e7;
}

.auth-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(54rpx + env(safe-area-inset-bottom));
  background: #f3f0e7;
  color: #18232d;
}

.auth-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 82rpx;
}

.auth-topbar .brand-row {
  gap: 18rpx;
}

.auth-topbar .brand-mark {
  width: 78rpx;
  height: 78rpx;
  border-radius: 26rpx;
  background: #244c66;
  color: #f0d6a4;
  box-shadow: 0 8rpx 18rpx rgba(24, 35, 45, .13);
}

.brand-copy {
  min-width: 0;
}

.brand-name,
.brand-subtitle {
  display: block;
}

.brand-name {
  color: #18232d;
  font-size: 34rpx;
  font-weight: 800;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #777e7b;
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 1.7rpx;
}

.online-status {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d7d1c4;
  border-radius: 999rpx;
  background: #fffefa;
  color: #59645f;
  font-size: 19rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(24, 35, 45, .06);
}

.online-dot,
.panel-dot,
.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #718b6a;
}

.auth-shell {
  width: 100%;
  max-width: 720rpx;
  margin: 42rpx auto 0;
}

.auth-hero {
  padding: 0 6rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #d5ccbc;
  border-radius: 999rpx;
  background: #fffefa;
  color: #395c74;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: 0 5rpx 15rpx rgba(24, 35, 45, .05);
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  background: #b85f4b;
}

.hero-title {
  display: block;
  margin-top: 34rpx;
  color: #18232d;
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.12;
}

.hero-title-accent {
  margin-top: 6rpx;
  color: #315e83;
}

.auth-panel {
  margin-top: 44rpx;
  padding: 34rpx 28rpx 28rpx;
  border: 1rpx solid #d7d1c4;
  border-radius: 24rpx;
  background: #fffefa;
  box-shadow: 0 18rpx 48rpx rgba(24, 35, 45, .11);
}

.panel-heading {
  margin-bottom: 28rpx;
}

.panel-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #315e83;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.panel-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-left: auto;
  border: 1rpx solid #ded8cc;
  border-radius: 12rpx;
  background: #f1ede4;
  color: #315e83;
  font-size: 24rpx;
}

.panel-title {
  display: block;
  margin-top: 20rpx;
  color: #18232d;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
}

.panel-detail {
  display: block;
  margin-top: 10rpx;
  color: #66717b;
  font-size: 24rpx;
  line-height: 1.6;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 28rpx;
  padding: 6rpx;
  border: 1rpx solid #ded8cc;
  border-radius: 16rpx;
  background: #ece8de;
}

.auth-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border: 1rpx solid transparent;
  border-radius: 13rpx;
  color: #727a78;
  font-size: 26rpx;
  font-weight: 800;
}

.auth-tab.active {
  border-color: #d7d1c4;
  background: #fffefa;
  color: #244c66;
  box-shadow: 0 3rpx 10rpx rgba(24, 35, 45, .07);
}

.auth-form {
  display: block;
}

.form-label,
.identity-label {
  display: block;
  color: #394950;
  font-size: 22rpx;
  font-weight: 800;
}

.form-label {
  margin: 22rpx 0 10rpx;
}

.compact-label {
  margin-top: 20rpx;
}

.field-shell,
.select-shell {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 100rpx;
  border: 1rpx solid #d7d1c4;
  border-radius: 16rpx;
  background: #fff;
}

.field-shell:focus-within,
.select-shell:active {
  border-color: #244c66;
  box-shadow: 0 0 0 6rpx rgba(197, 212, 217, .7);
}

.field-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  margin-left: 22rpx;
  color: #8a918f;
  font-size: 23rpx;
  font-weight: 800;
}

.field-input {
  min-width: 0;
  flex: 1;
  height: 98rpx;
  padding: 0 18rpx;
  color: #24323a;
  font-size: 27rpx;
}

.password-toggle {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  color: #8a918f;
}

.eye-icon {
  position: relative;
  width: 34rpx;
  height: 22rpx;
  border: 3rpx solid #8a918f;
  border-radius: 50% / 65%;
}

.eye-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #8a918f;
  content: "";
  transform: translate(-50%, -50%);
}

.eye-hidden .eye-icon::before {
  position: absolute;
  top: 8rpx;
  left: -7rpx;
  width: 48rpx;
  height: 3rpx;
  background: #8a918f;
  content: "";
  transform: rotate(-35deg);
}

.input-placeholder,
.placeholder-value {
  color: #9a9f9c;
}

.auth-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 16rpx;
  background: #244c66;
  color: #fffefa;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(36, 76, 102, .2);
}

.auth-submit[disabled] {
  opacity: .55;
}

.submit-arrow {
  margin-left: 14rpx;
  font-size: 32rpx;
}

.auth-error,
.auth-notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.auth-error {
  border: 1rpx solid #f0c9c2;
  background: #fff1ef;
  color: #a9473d;
}

.auth-notice {
  border: 1rpx solid #bde0c3;
  background: #eef9ef;
  color: #2e7951;
}

.auth-security {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 26rpx;
  color: #8a918f;
  font-size: 19rpx;
  line-height: 1.5;
}

.security-symbol {
  color: #718b6a;
  font-size: 22rpx;
  font-weight: 800;
}

@media (max-width: 390px) {
  .auth-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .online-status {
    display: none;
  }

  .hero-title {
    font-size: 52rpx;
  }

  .auth-panel {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
}
