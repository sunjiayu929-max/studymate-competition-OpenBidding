.detail-heading {
  position: relative;
  padding: 12rpx 4rpx 34rpx;
}

.detail-status {
  margin-left: 10rpx;
}

.detail-title {
  display: block;
  margin-top: 22rpx;
  color: #21465e;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.4;
}

.detail-meta {
  display: block;
  margin-top: 12rpx;
  color: #718b99;
  font-size: 23rpx;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx;
  border-color: #bcd9e7;
  background: linear-gradient(135deg, #f4fafd 0%, #e5f3f8 100%);
}

.action-copy {
  min-width: 0;
}

.action-label,
.action-status {
  display: block;
}

.action-label {
  color: #718b99;
  font-size: 21rpx;
}

.action-status {
  margin-top: 6rpx;
  color: #21465e;
  font-size: 28rpx;
  font-weight: 800;
}

.action-button {
  flex: 0 0 240rpx;
  min-height: 76rpx;
  font-size: 24rpx;
}

.completed-mark {
  flex: 0 0 160rpx;
  color: #2f7196;
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}

.content-section {
  padding: 34rpx 4rpx 0;
}

.material-section {
  margin-top: 30rpx;
  padding: 34rpx 26rpx 30rpx;
  border-top: 1rpx solid #cfe3ed;
  background: #fff;
}

.body-copy,
.knowledge-detail {
  display: block;
  margin-top: 18rpx;
  color: #526f80;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.material-block {
  padding: 24rpx 0 8rpx;
}

.material-block + .material-block {
  margin-top: 12rpx;
  border-top: 1rpx solid #e5f0f5;
}

.material-subtitle {
  display: block;
  color: #2d5871;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.55;
}

.material-copy {
  margin-top: 12rpx;
}

.knowledge-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e5f0f5;
}

.knowledge-item:last-child {
  border-bottom: 0;
}

.knowledge-title {
  display: block;
  color: #2f7196;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.5;
}

.knowledge-detail {
  margin-top: 8rpx;
  font-size: 25rpx;
}

.retry-button {
  min-height: 72rpx;
  margin-top: 22rpx;
}
