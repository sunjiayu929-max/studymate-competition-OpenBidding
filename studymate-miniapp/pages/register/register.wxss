@import "../login/login.wxss";

.register-panel {
  margin-top: 40rpx;
}

.identity-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #c6dfeb;
  border-radius: 14rpx;
  background: #f2f9fc;
}

.choice-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.choice-grid-secondary {
  margin-top: 14rpx;
}

.choice-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid #d4e7f0;
  border-radius: 12rpx;
  background: #fff;
  color: #65808f;
  font-size: 23rpx;
  font-weight: 800;
}

.choice-button.selected.learner {
  border-color: #2f7196;
  background: #2f7196;
  color: #fff;
  box-shadow: none;
}

.choice-button.selected.admin {
  border-color: #397fa3;
  background: #397fa3;
  color: #fff;
  box-shadow: none;
}

.choice-button.secondary {
  border-color: #c6dfeb;
}

.choice-button.selected.student {
  border-color: #9bc7dc;
  background: #e0f0f7;
  color: #286486;
}

.choice-button.selected.worker {
  border-color: #9bc7dc;
  background: #e0f0f7;
  color: #286486;
}

.select-value {
  min-width: 0;
  flex: 1;
  padding: 0 18rpx;
  font-size: 27rpx;
}

.selected-value {
  color: #18384d;
}

.select-arrow {
  margin-right: 22rpx;
  color: #7893a1;
  font-size: 32rpx;
}

.code-row {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.code-input-wrap {
  min-width: 0;
  flex: 1;
}

.code-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 190rpx;
  min-height: 100rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #c5deea;
  border-radius: 14rpx;
  background: #f7fbfd;
  color: #356d8b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.code-button[disabled] {
  color: #93a7b1;
  opacity: .65;
}

.helper-text {
  margin-top: 16rpx;
  color: #7893a1;
  font-size: 20rpx;
  line-height: 1.6;
}
